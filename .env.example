# Copy to .env.local for local overrides. Never commit real values.
# Without DATABASE_URL the app uses an in-memory PGlite database with fake demo data.
DATABASE_URL=
# Where sign-in and manage links point.
APP_URL=http://localhost:3000
# "log" prints emails to the console and keeps them in the outbox; "resend" sends them.
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM="Sevak <notify@sevak.theanbgroup.com>"
